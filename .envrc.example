# Local e2e configuration for `make test-e2e` against a kind cluster + live GitLab.
# Copy to `.envrc` (gitignored), fill in real values, and `direnv allow`.
# These mirror the GitHub Actions secrets of the same names used by the e2e workflow.
#
# The OpenTofu stack in test/e2e/terraform provisions the project, CI file, and a
# token with the right scopes, and can emit this file directly:
#   cd test/e2e/terraform && tofu output -raw e2e_env > "$(git rev-parse --show-toplevel)/.envrc"

# GitLab instance the test runner registers against.
export GITLAB_E2E_URL="https://gitlab.com/"

# Optional. Tag this run registers its runner with, and pins its pipeline to via
# the RUNNER_TAG pipeline variable. Leave unset locally: the suite falls back to
# the CI file's default. CI sets a value per run, attempt and Kubernetes
# version so concurrent runs
# cannot pick up each other's jobs.
# export GITLAB_E2E_RUNNER_TAG="e2e-local-$USER"

# Access token needing BOTH `api` and `create_runner` scopes, and Maintainer on
# the project: `api` reads the project and triggers pipelines, `create_runner`
# mints runners. Use a throwaway/test project, not anything sensitive.
export GITLAB_E2E_TOKEN="glpat-REPLACE_ME"

# Numeric id of the GitLab project the managed runner is created against.
export GITLAB_E2E_PROJECT_ID="0"
