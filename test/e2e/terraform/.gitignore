# Local OpenTofu working files. Never commit state: it maps config to live
# GitLab resources and can hold the project access token in plaintext.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable files may carry the bootstrap token; keep only the example.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Generated by `tofu output -raw e2e_env`.
.envrc

# The dependency lock file (.terraform.lock.hcl) is intentionally NOT ignored;
# commit it so provider versions are reproducible.
